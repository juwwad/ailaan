# Google Flood Forecasting API key.
# Get one from https://developers.google.com/flood-forecasting (enable the
# "Flood Forecasting API" in a Google Cloud project).
# If unset, the service serves clearly-labeled simulated data.
GOOGLE_FLOOD_API_KEY=

# Port the service listens on. The Next.js proxy defaults to http://localhost:5000.
PORT=5000

# Comma-free single origin allowed for CORS, or * for any. The Next.js proxy
# calls this service server-side, so the default is fine for local development.
CORS_ORIGIN=*

# Upstream request timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=10000
